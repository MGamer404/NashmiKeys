<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>NashmiKeys</AssemblyName>
    <AssemblyTitle>NashmiKeys</AssemblyTitle>
    <RootNamespace>NashmiKeys.App</RootNamespace>
    <Version>1.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>NashmiKeys</Product>
    <Company>AbuNashmi</Company>
    <Description>Controller chord hotkeys for Windows</Description>
    <Copyright>© 2026 AbuNashmi</Copyright>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NashmiKeys.Core\NashmiKeys.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\third_party\sdl\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\third_party\sdl\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
