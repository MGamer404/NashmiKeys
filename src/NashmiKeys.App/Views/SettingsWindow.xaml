<Window x:Class="NashmiKeys.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="680" Height="740"
        MinWidth="600" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18,24,16">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource H1Text}" />
                <TextBlock Text="Startup, timing and diagnostics." Style="{StaticResource SmallMutedText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,12">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="GENERAL" Style="{StaticResource CaptionText}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                <TextBlock Text="Registers a Task Scheduler task named NashmiKeys with highest privileges, so Windows starts it at logon without a UAC prompt."
                                           Style="{StaticResource SmallMutedText}"
                                           Margin="0,3,0,0" />
                                <TextBlock x:Name="StartupStatusText" Style="{StaticResource SmallMutedText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" />
                        </Grid>

                        <Separator Margin="0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Start minimized" FontWeight="SemiBold" />
                                <TextBlock Text="Start hidden in the tray. Usually paired with Start with Windows."
                                           Style="{StaticResource SmallMutedText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="StartMinimizedToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" />
                        </Grid>

                        <Separator Margin="0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Minimize and close to tray" FontWeight="SemiBold" />
                                <TextBlock Text="When enabled, minimizing or pressing X hides the window to the tray so hotkeys keep working. Exit from the tray menu or File menu; X never exits."
                                           Style="{StaticResource SmallMutedText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="MinimizeToTrayToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TIMING" Style="{StaticResource CaptionText}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Combo hold delay" FontWeight="SemiBold" />
                            <TextBlock x:Name="ComboHoldValueText" Grid.Column="1" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="ComboHoldSlider" Minimum="0" Maximum="500" SmallChange="10" LargeChange="50" Margin="0,4,0,0" ValueChanged="ComboHoldSlider_ValueChanged" />
                        <TextBlock Text="0 ms activates immediately. A higher value guards against accidental chords; the chord must stay down for the whole delay."
                                   Style="{StaticResource SmallMutedText}"
                                   Margin="0,2,0,0" />

                        <Separator Margin="0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="L2 / LT trigger threshold" FontWeight="SemiBold" />
                            <TextBlock x:Name="L2ValueText" Grid.Column="1" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="L2Slider" Minimum="0.05" Maximum="0.99" SmallChange="0.05" LargeChange="0.1" Margin="0,4,0,0" ValueChanged="L2Slider_ValueChanged" />
                        <TextBlock Text="Analog trigger travel needed before it counts as the L2 input. Releases 0.05 below the activation point."
                                   Style="{StaticResource SmallMutedText}"
                                   Margin="0,2,0,0" />

                        <Separator Margin="0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R2 / RT trigger threshold" FontWeight="SemiBold" />
                            <TextBlock x:Name="R2ValueText" Grid.Column="1" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="R2Slider" Minimum="0.05" Maximum="0.99" SmallChange="0.05" LargeChange="0.1" Margin="0,4,0,0" ValueChanged="R2Slider_ValueChanged" />
                        <TextBlock Text="Analog trigger travel needed before it counts as the R2 input. Releases 0.05 below the activation point."
                                   Style="{StaticResource SmallMutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DIAGNOSTICS" Style="{StaticResource CaptionText}" />
                            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Click="RefreshDiagnostics_Click" />
                        </Grid>
                        <TextBlock x:Name="DiagnosticsText"
                                   Style="{StaticResource SmallMutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="FOLDERS" Style="{StaticResource CaptionText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Open config folder" Style="{StaticResource SecondaryButton}" Click="OpenConfigFolder_Click" />
                            <Button Content="Open log folder" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenLogFolder_Click" />
                        </StackPanel>
                        <TextBlock x:Name="FoldersText" Style="{StaticResource SmallMutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ValidationText"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="90" IsCancel="True" Click="Cancel_Click" />
                    <Button Content="Save settings" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="8,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
