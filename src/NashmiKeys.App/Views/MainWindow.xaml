<Window x:Class="NashmiKeys.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NashmiKeys"
        Width="980" Height="680"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
                Height="72"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource LogoGradient}">
                        <TextBlock Text="PH"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NashmiKeys"
                               Margin="10,0,0,0"
                               FontSize="19"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ControllerPill" Style="{StaticResource Pill}" MaxWidth="220" ToolTip="Controller status">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ControllerDot" Width="8" Height="8" Fill="{StaticResource FaintBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ControllerStatusText"
                                       Text="No controller"
                                       FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="BatteryText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ToggleButton x:Name="PauseToggle"
                                  Content="Pause hotkeys"
                                  Style="{StaticResource PauseToggle}"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="PauseToggle_Changed"
                                  Unchecked="PauseToggle_Changed"
                                  ToolTip="Pause or resume hotkey injection" />

                    <Button x:Name="AddHotkeyButton"
                            Content="Add hotkey"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="AddHotkey_Click" />

                    <Button x:Name="FileButton"
                            Content="File"
                            Style="{StaticResource GhostButton}"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Click="FileButton_Click" />

                    <Popup x:Name="FilePopup"
                           PlacementTarget="{Binding ElementName=FileButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Width="232"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6"
                                Margin="0,5,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.55" Color="#000000" />
                            </Border.Effect>
                            <StackPanel>
                                <Button Content="Settings" Style="{StaticResource MenuButton}" Click="Settings_Click" />
                                <Button Content="Open config folder" Style="{StaticResource MenuButton}" Click="OpenConfigFolder_Click" />
                                <Separator Margin="6,4" />
                                <Button Content="Exit" Style="{StaticResource MenuButton}" Foreground="{StaticResource DangerBrush}" Click="Exit_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Warning/error banners -->
        <StackPanel x:Name="BannerPanel"
                    Grid.Row="1"
                    Margin="18,10,18,0"
                    Visibility="Collapsed" />

        <!-- Hotkey list -->
        <Grid Grid.Row="2" Margin="18,16,18,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="4,0,4,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Hotkeys" Style="{StaticResource H2Text}" />
                            <TextBlock Text="Controller chords become keyboard output. A chord is a set, so button order does not matter."
                                       Style="{StaticResource SmallMutedText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="HotkeyCountText"
                                   Grid.Column="1"
                                   Style="{StaticResource SmallMutedText}"
                                   VerticalAlignment="Bottom"
                                   Margin="12,0,0,4" />
                    </Grid>

                    <ItemsControl x:Name="HotkeyItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="18">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           Style="{StaticResource CardTitleText}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border x:Name="ModeBadge"
                                                        Grid.Column="1"
                                                        Background="{StaticResource AccentSoftBrush}"
                                                        CornerRadius="5"
                                                        Padding="7,2"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="ModeTextBlock"
                                                               Text="{Binding ModeText}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentHoverBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="3"
                                                           Text="Enabled"
                                                           Style="{StaticResource SmallMutedText}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,7,0" />
                                                <ToggleButton Grid.Column="4"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Style="{StaticResource ToggleSwitch}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Enable or disable this hotkey" />
                                            </Grid>

                                            <WrapPanel Margin="0,11,0,0" VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding InputChips}" Margin="0,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource InputChip}">
                                                                <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="→"
                                                           FontSize="15"
                                                           Foreground="{StaticResource FaintBrush}"
                                                           Margin="3,0,9,6"
                                                           VerticalAlignment="Center" />

                                                <ItemsControl ItemsSource="{Binding OutputChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Chip}">
                                                                <TextBlock Text="{Binding}" FontSize="11.5" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Edit" Style="{StaticResource GhostButton}" Padding="8,5" FontSize="12" Click="EditHotkey_Click" />
                                            <Button Content="Duplicate" Style="{StaticResource GhostButton}" Padding="8,5" FontSize="12" Click="DuplicateHotkey_Click" />
                                            <Button Content="Delete" Style="{StaticResource DangerGhostButton}" Padding="8,5" FontSize="12" Click="DeleteHotkey_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="Tap">
                                        <Setter TargetName="ModeBadge" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        <Setter TargetName="ModeTextBlock" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="Toggle">
                                        <Setter TargetName="ModeBadge" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                        <Setter TargetName="ModeTextBlock" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="44,38" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="62" Height="62" CornerRadius="18" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="+"
                                           FontSize="30"
                                           FontWeight="Light"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-3,0,0" />
                            </Border>
                            <TextBlock Text="No hotkeys yet"
                                       Style="{StaticResource H2Text}"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0" />
                            <TextBlock Text="Create a chord from controller buttons and choose the keyboard keys it should press. For example, hold L3 + R3 to send Win."
                                       Style="{StaticResource SmallMutedText}"
                                       TextAlignment="Center"
                                       MaxWidth="430"
                                       Margin="0,8,0,0" />
                            <Button Content="Add your first hotkey"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0"
                                    Click="AddHotkey_Click" />
                        </StackPanel>
                    </Border>

                    <Border Height="18" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Live status strip -->
        <Border Grid.Row="3"
                Height="48"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PRESSED"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />

                <ScrollViewer Grid.Column="1"
                              Margin="12,0,12,0"
                              VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="PressedItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InputChip}" Margin="0,0,6,0" Padding="7,2">
                                        <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PressedNoneText"
                                   Text="No controller input"
                                   Style="{StaticResource SmallMutedText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="LastFiredText"
                           Grid.Column="2"
                           Text="Last fired: —"
                           Style="{StaticResource SmallMutedText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300" />
            </Grid>
        </Border>
    </Grid>
</Window>
