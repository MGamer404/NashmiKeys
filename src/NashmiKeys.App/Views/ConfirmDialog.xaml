<Window x:Class="NashmiKeys.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Confirm" Style="{StaticResource H2Text}" />
            <TextBlock x:Name="MessageText"
                       Text="Are you sure?"
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,9,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="90"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button x:Name="ConfirmButton"
                    Content="Delete"
                    Style="{StaticResource DangerGhostButton}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
