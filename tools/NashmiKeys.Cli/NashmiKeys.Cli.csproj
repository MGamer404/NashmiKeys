<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>NashmiKeys.Cli</AssemblyName>
    <RootNamespace>NashmiKeys.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NashmiKeys.Core\NashmiKeys.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\third_party\sdl\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\sdl\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
